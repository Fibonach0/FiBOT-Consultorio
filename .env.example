# Supabase (un solo proyecto para TODOS los tenants — no hay un proyecto por profesional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Business — una sola App/System User para toda la plataforma.
# Cada profesional (tenant) agrega su número de WhatsApp Business a ESTA misma
# App/Business Portfolio; lo que los distingue es whatsapp_phone_number_id,
# que vive en la tabla tenants, NO acá.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Clave para firmar la cookie de sesión del panel (cualquier string largo y random)
FLASK_SECRET_KEY=

# Cada cuántos minutos corre el chequeo de recordatorios (default 10)
RECORDATORIO_INTERVALO_MIN=10
