# Supabase (un solo proyecto para TODOS los tenants — no hay un proyecto por profesional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Business — una sola App/System User para toda la plataforma.
# Cada profesional (tenant) agrega su número de WhatsApp Business a ESTA misma
# App/Business Portfolio; lo que los distingue es whatsapp_phone_number_id,
# que vive en la tabla tenants, NO acá.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Clave para firmar la cookie de sesión del panel (cualquier string largo y random)
FLASK_SECRET_KEY=

# Cada cuántos minutos corre el chequeo de recordatorios (default 10)
RECORDATORIO_INTERVALO_MIN=10

# --- Modo "sin número propio" (opcional pero recomendado para el arranque) ---
# phone_number_id del número de WhatsApp de la plataforma. Si está seteado, un
# tenant que NO tenga whatsapp_phone_number_id propio manda y recibe por acá:
# el mensaje entrante se resuelve al tenant por el teléfono del paciente
# (db.tenant_por_paciente), no por el número al que le escribieron.
PLATAFORMA_PHONE_NUMBER_ID=

# Plantilla aprobada por Meta para el recordatorio de turno. SIN esto el
# recordatorio sale como texto libre y Meta lo rechaza salvo que el paciente
# haya escrito en las últimas 24 h — que es justo lo que NO pasa la noche
# anterior al turno. Tiene que aceptar dos parámetros de body:
#   {{1}} = nombre del profesional   {{2}} = cuándo es el turno
RECORDATORIO_TEMPLATE=
RECORDATORIO_TEMPLATE_LANG=es_AR
